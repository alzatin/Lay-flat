          "ioValue": "Z"
        }
      ],
      "codeVersion": 1,
      "code": "const Inputs = [\n  { inputName: \"geometry\", type: \"geometry\", defaultValue: null },\n  { inputName: \"Axis\", type: \"string\", defaultValue: \"X\" },\n];\nlet axisAngles = [0,0,90]\nif (Axis == \"X\") {\n  axisAngles = [90,0,0]\n}\nelse if (Axis == \"Y\") {\n  axisAngles = [0,90,0]\n}\nelse if (Axis == \"Z\") {\n  axisAngles = [0,0,90]\n}\n\nlet importedGeometry = library[geometry];\n\n// Rotate 90° around Y-axis to lay the 300 × 100 face flat on XY\nlet rotated = await Rotate(importedGeometry, axisAngles[0], axisAngles[1], axisAngles[2]);\n\n// Auto-detect Z position and move to XY plane\nlet bounds = await GetBounds(rotated);\nlet zOffset = -bounds.min[2]\nlet flatOnXY = await Move(rotated, 0, 0, zOffset);\n\nlet result = {\n  geometry: [flatOnXY],\n  dimension: \"3D\",\n  tags: [\"flatOnWidestFace\"],\n  color: \"#A3CE5B\",\n  plane: new replicad.Plane(),\n  bom: []\n};\n\nreturn result;"
    },
