      "codeVersion": 1,
      "code": "const Inputs = [\n  { inputName: \"geometry\", type: \"geometry\", defaultValue: null }\n];\nconsole.log(geometry)\nlet importedGeometry = library[geometry];\nconsole.log(importedGeometry)\nconsole.log( await GetBounds(importedGeometry))\n// Rotate 90 degrees around X-axis to lay flat\nlet flatGeometry = await Rotate(importedGeometry, 90, 0, 0);\n\n// Get bounds and automatically move to z = 0\nlet bounds = await GetBounds(geometry);\nconsole.log(bounds)\nlet zOffset = -bounds.min[2]\nlet flatOnXY = await Move(flatGeometry, 0, 0, zOffset);\n\nlet result = {\n  geometry: [flatOnXY],\n  dimension: \"3D\",\n  tags: [\"flatOnXY\"],\n  color: \"#A3CE5B\",\n  plane: new replicad.Plane(),\n  bom: []\n};\n\nreturn result;"
